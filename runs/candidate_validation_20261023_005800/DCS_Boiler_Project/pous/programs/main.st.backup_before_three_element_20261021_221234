PROGRAM main
VAR
    (* Existing Modbus register map: preserve compatibility *)
    PLCHeartbeat       : INT AT %MW100 := 0;
    DrumLevel_x100     : INT AT %MW101 := 5000;
    FeedwaterFlow_x1000: INT AT %MW102 := 1000;
    SteamFlow_x1000   : INT AT %MW103 := 1000;
    LevelSP_x100       : INT AT %MW104 := 5000;
    ManualValve_x10    : INT AT %MW105 := 500;
    FeedwaterValve_x10 : INT AT %MW106 := 500;
    AutoMode_x10       : INT AT %MW107 := 0;

    (* Controller configuration *)
    Kp                 : REAL := 1.5;
    Ki                 : REAL := 0.2;
    CycleTime_s        : REAL := 0.02;
    OutputBias         : REAL := 50.0;
    OutputMin          : REAL := 0.0;
    OutputMax          : REAL := 100.0;
    IntegralMin        : REAL := -50.0;
    IntegralMax        : REAL := 50.0;

    (* Internal controller state *)
    LevelError         : REAL := 0.0;
    IntegralTerm       : REAL := 0.0;
    CandidateIntegral  : REAL := 0.0;
    CandidateOutput    : REAL := 50.0;
    ValvePercent       : REAL := 50.0;
    ManualPercent      : REAL := 50.0;
    AutoActive         : BOOL := FALSE;
    PreviousAutoMode   : BOOL := FALSE;
END_VAR

(* Calculate level error in percentage points *)
LevelError :=
    INT_TO_REAL(LevelSP_x100 - DrumLevel_x100) / 100.0;

(* Limit manual command to 0–100% *)
IF ManualValve_x10 > 1000 THEN
    ManualValve_x10 := 1000;
END_IF;

IF ManualValve_x10 < 0 THEN
    ManualValve_x10 := 0;
END_IF;

ManualPercent := INT_TO_REAL(ManualValve_x10) / 10.0;
AutoActive := AutoMode_x10 > 0;

(* Manual / automatic controller *)
IF NOT AutoActive THEN

    (* Manual output *)
    ValvePercent := ManualPercent;

    (* Track integral state for bumpless transfer *)
    IntegralTerm :=
        ValvePercent - OutputBias - Kp * LevelError;

    IF IntegralTerm > IntegralMax THEN
        IntegralTerm := IntegralMax;
    END_IF;

    IF IntegralTerm < IntegralMin THEN
        IntegralTerm := IntegralMin;
    END_IF;

ELSE

    (* Initialize controller state on entry to automatic mode *)
    IF NOT PreviousAutoMode THEN
        IntegralTerm :=
            ManualPercent - OutputBias - Kp * LevelError;

        IF IntegralTerm > IntegralMax THEN
            IntegralTerm := IntegralMax;
        END_IF;

        IF IntegralTerm < IntegralMin THEN
            IntegralTerm := IntegralMin;
        END_IF;
    END_IF;

    (* Calculate candidate integral *)
    CandidateIntegral :=
        IntegralTerm + Ki * LevelError * CycleTime_s;

    IF CandidateIntegral > IntegralMax THEN
        CandidateIntegral := IntegralMax;
    END_IF;

    IF CandidateIntegral < IntegralMin THEN
        CandidateIntegral := IntegralMin;
    END_IF;

    (* Calculate candidate output *)
    CandidateOutput :=
        OutputBias + Kp * LevelError + CandidateIntegral;

    (* Conditional integration for anti-windup *)
    IF (CandidateOutput >= OutputMin)
       AND (CandidateOutput <= OutputMax) THEN

        IntegralTerm := CandidateIntegral;

    ELSIF (CandidateOutput > OutputMax)
       AND (LevelError < 0.0) THEN

        IntegralTerm := CandidateIntegral;

    ELSIF (CandidateOutput < OutputMin)
       AND (LevelError > 0.0) THEN

        IntegralTerm := CandidateIntegral;

    END_IF;

    (* Calculate final automatic output *)
    ValvePercent :=
        OutputBias + Kp * LevelError + IntegralTerm;

END_IF;

(* Enforce output limits *)
IF ValvePercent > OutputMax THEN
    ValvePercent := OutputMax;
END_IF;

IF ValvePercent < OutputMin THEN
    ValvePercent := OutputMin;
END_IF;

(* Convert percentage to register units *)
FeedwaterValve_x10 := REAL_TO_INT(ValvePercent * 10.0);

(* Save mode state for the next PLC scan *)
PreviousAutoMode := AutoActive;

(* Heartbeat counter *)
IF PLCHeartbeat >= 30000 THEN
    PLCHeartbeat := 0;
ELSE
    PLCHeartbeat := PLCHeartbeat + 1;
END_IF;

END_PROGRAM